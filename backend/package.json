    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "ulid": "^3.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.3",
